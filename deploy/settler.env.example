# /etc/ballisflat/settler.env (chmod 600, owner root). Read by ballisflat-settler.service.
# Owner decided 9 Nov 2026: the owner wallet is also the settler, so this is the owner key (same as
# DEPLOYER_KEY in deploy/mainnet.env). It can do every owner action on both contracts, including setTreasury
# on the Hunt: keep this file root-only and nowhere else on the box.
SETTLER_KEY=0x
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The local API, so matches added through /ops are settled too.
API_URL=http://127.0.0.1:42069
# Minutes after full time before posting, so FotMob's ratings settle.
SETTLE_AFTER_MINUTES=30
