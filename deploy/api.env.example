# /etc/ballisflat/api.env (chmod 600). Read by ballisflat-api.service.
NODE_ENV=production
NETWORK=mainnet
DATABASE_URL=postgres://ballisflat:CHANGE_ME@127.0.0.1:5432/ballisflat
# New schema per contract deploy or indexer change; the view schema "ballisflat" always points at the live one.
DATABASE_SCHEMA=ballisflat_v1
RPC_URL=https://rpc.mainnet.chain.robinhood.com
PUBLIC_API_URL=https://wif-api.ballisflat.fun
PUBLIC_APP_URL=https://wif.ballisflat.fun
CORS_ORIGINS=https://wif.ballisflat.fun
# openssl rand -hex 32; the owner pastes it into /ops
ADMIN_TOKEN=
