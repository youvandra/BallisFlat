# /etc/caddy/Caddyfile on cordon-server. Caddy gets TLS from Let's Encrypt per host once DNS points here.
# One app: Ball is Flat on Robinhood Chain ($WIF). Web at ballisflat.fun, API at api.ballisflat.fun.

ballisflat.fun {
	root * /srv/ballisflat/web
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html and the SPA routes it serves) revalidates, so a deploy shows on the next load.
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

api.ballisflat.fun {
	encode zstd gzip
	reverse_proxy 127.0.0.1:42069
}

# Old and alternate names point at the real ones.
www.ballisflat.fun, wif.ballisflat.fun {
	redir https://ballisflat.fun{uri} 301
}

wif-api.ballisflat.fun {
	redir https://api.ballisflat.fun{uri} 301
}
