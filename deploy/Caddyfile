# /etc/caddy/Caddyfile on cordon-server. Caddy gets TLS from Let's Encrypt once DNS points here
# and ports 80/443 are open in cordon-server-sg.

ballisflat.fun {
	root * /srv/ballisflat/web
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

www.ballisflat.fun {
	redir https://ballisflat.fun{uri} permanent
}

api.ballisflat.fun {
	encode zstd gzip
	reverse_proxy 127.0.0.1:42069
}
