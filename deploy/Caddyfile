# /etc/caddy/Caddyfile on cordon-server. Caddy gets TLS from Let's Encrypt per host once DNS points here.
# ballisflat.fun is the Ball is Flat profile page; each hackathon edition is its own app on its own subdomain
# (wif = $WIF on Robinhood Chain; near comes later), so one edition can change without touching the other.

# Until the profile page exists, the root sends visitors to the $WIF edition (302, so browsers do not cache it).
# Profile page later: root * /srv/ballisflat/site, encode zstd gzip, try_files {path} {path}.html /index.html, file_server.
ballisflat.fun, www.ballisflat.fun {
	redir https://wif.ballisflat.fun{uri} 302
}

wif.ballisflat.fun {
	root * /srv/ballisflat/wif/web
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

wif-api.ballisflat.fun {
	encode zstd gzip
	reverse_proxy 127.0.0.1:42069
}
