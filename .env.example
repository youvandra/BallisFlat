# Copy to .env. Every variable is parsed in apps/web/src/lib/env.ts; nothing reads import.meta.env elsewhere.
VITE_SITE_URL=http://localhost:5173
# chain = Robinhood Chain via the deployed contract (production default); mock = in-browser chain for development
VITE_DATA_MODE=chain
VITE_NETWORK=mainnet
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
