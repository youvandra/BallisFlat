# Copy to .env. Every variable is parsed in apps/web/src/lib/env.ts; nothing reads import.meta.env elsewhere.
VITE_SITE_URL=http://localhost:5173
# mock = in-browser demo chain (no wallet needed); chain = Robinhood Chain via the deployed contract
VITE_DATA_MODE=mock
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
